<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="crx_bimanual">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import crx_bimanual urdf file -->
    <xacro:include filename="$(find crx_description)/urdf/crx_bimanual/crx_bimanual.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="crx_bimanual.ros2_control.xacro" />


    <xacro:crx_bimanual_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
